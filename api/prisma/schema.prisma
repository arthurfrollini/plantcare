generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlantSource {
  curated
  ai
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String?        @unique // stored trimmed and lowercased
  passwordHash    String?
  googleId        String?        @unique
  language        String         @default("en") // "en" | "pt-BR", validated by zod
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  avatarPath      String?
  avatarUpdatedAt DateTime?
  refreshTokens   RefreshToken[]
  plants          UserPlant[]
  aiProposals     AiProposal[]
  aiUsage         AiUsage[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Plant {
  id             String             @id @default(cuid())
  slug           String             @unique
  scientificName String             @unique
  source         PlantSource        @default(curated)
  light          String
  difficulty     String
  frequencyTimes Int
  frequencyPer   String
  imageFile      String?
  /// Stored photo (storage key), preferred over imageFile when set.
  imageKey       String?
  imageSource    String?
  imageAuthor    String?
  imageLicense   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  translations   PlantTranslation[]
  aliases        PlantAlias[]
  userPlants     UserPlant[]
}

model PlantTranslation {
  id         String @id @default(cuid())
  plantId    String
  plant      Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  locale     String // "en" | "pt-BR"
  name       String
  searchName String // lowercased, accents removed
  about      String
  waterTips  String

  @@unique([plantId, locale])
  @@index([searchName])
}

model PlantAlias {
  id         String @id @default(cuid())
  plantId    String
  plant      Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name       String
  searchName String

  @@index([searchName])
  @@index([plantId])
}

model UserPlant {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogPlantId      String
  catalogPlant        Plant      @relation(fields: [catalogPlantId], references: [id])
  nickname            String?
  wateringDays        Int[]      @default([])
  reminderTime        String
  reminderLeadMinutes Int        @default(15)
  scheduleStartsOn    DateTime?  @db.Date
  timeZone            String
  notes               String?
  photoPath           String?
  photoUpdatedAt      DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  waterings           Watering[]
  checkups            Checkup[]

  @@index([userId])
}

model Watering {
  id          String    @id @default(cuid())
  userPlantId String
  userPlant   UserPlant @relation(fields: [userPlantId], references: [id], onDelete: Cascade)
  wateredOn   DateTime  @db.Date
  createdAt   DateTime  @default(now())

  @@unique([userPlantId, wateredOn])
  @@index([userPlantId])
}

/// A species the model proposed, held until the user confirms it (24 h).
model AiProposal {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload          Json
  photoKey         String?
  /// The species photo search: none (not yet, or every source failed), found, notFound.
  referenceStatus  String    @default("none")
  /// The checked photo, cropped like a species photo, and its credit; set when found.
  referenceKey     String?
  referenceAuthor  String?
  referenceLicense String?
  referenceSource  String?
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// One AI check-up of a sick plant.
model Checkup {
  id          String    @id @default(cuid())
  userPlantId String
  userPlant   UserPlant @relation(fields: [userPlantId], references: [id], onDelete: Cascade)
  photoKey    String
  description String?
  problem     String
  steps       String[]
  whenToWorry String
  status      String    @default("open") // "open" | "healed", validated by zod
  createdAt   DateTime  @default(now())
  healedAt    DateTime?

  @@index([userPlantId, createdAt])
}

/// Model calls per user per UTC day, for the daily limits and the spend ceiling.
model AiUsage {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  kind    String // "identify" | "checkup" | "speciesPhoto"
  count   Int      @default(0)
  costUsd Decimal  @default(0) @db.Decimal(10, 6)

  @@id([userId, day, kind])
  @@index([day])
}
