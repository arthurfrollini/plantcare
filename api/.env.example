DATABASE_URL=postgresql://postgres:postgres@localhost:5433/plantcare
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=
UPLOADS_DIR=uploads
PORT=3333
CORS_ORIGIN=*

# Plant AI (identification and check-ups). Without a key the AI features are off.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# Spend ceiling for all users together, per UTC day. 0 turns the AI off.
# AI_DAILY_SPEND_LIMIT_USD=0.5
