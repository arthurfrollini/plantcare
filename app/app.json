{
  "expo": {
    "name": "PlantCare",
    "slug": "plantcare",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlantCare uses your photos so you can add a picture of your plant.",
          "cameraPermission": "PlantCare uses the camera so you can take a picture of your plant.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
